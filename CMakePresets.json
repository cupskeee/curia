{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "curia-arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS x86_64 (cross-built on Apple silicon)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "curia-x64-osx",
        "VCPKG_HOST_TRIPLET": "curia-arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CURIA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86_64",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "curia-x64-linux"
      }
    },
    {
      "name": "linux-x64-sanitize",
      "displayName": "Linux x86_64, core + tests with ASan/UBSan",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "curia-x64-linux",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "CURIA_BUILD_APP": "OFF",
        "CURIA_SANITIZE": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "curia-x64-windows"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-x64-sanitize",
      "configurePreset": "linux-x64-sanitize"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "network|netinfo"
        }
      }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "inherits": "base-test"
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64",
      "inherits": "base-test"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "inherits": "base-test"
    },
    {
      "name": "linux-x64-sanitize",
      "configurePreset": "linux-x64-sanitize",
      "inherits": "base-test"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "inherits": "base-test",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-network",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "network"
        }
      }
    },
    {
      "name": "linux-x64-network",
      "configurePreset": "linux-x64",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "network"
        }
      }
    },
    {
      "name": "windows-x64-network",
      "configurePreset": "windows-x64",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "network"
        }
      },
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-netinfo",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "netinfo"
        }
      }
    },
    {
      "name": "linux-x64-netinfo",
      "configurePreset": "linux-x64",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "netinfo"
        }
      }
    },
    {
      "name": "windows-x64-netinfo",
      "configurePreset": "windows-x64",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "netinfo"
        }
      },
      "configuration": "Release"
    }
  ]
}
